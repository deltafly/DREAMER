# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
/prompt/

server.log
# Skills directory
/skills/

# local database + exports (schema lives in prisma/, data does not belong in git)
# not anchored to root: `prisma migrate` resolves a relative DATABASE_URL against
# prisma/, so a stray prisma/db/*.db appears whenever migrations run.
*.db
*.db-journal
*.db-wal
*.db-shm
db/exports/

# this project uses Bun — bun.lock is the lockfile of record
package-lock.json
yarn.lock
pnpm-lock.yaml

# working files that must never reach the public repo
/tool-results/
*.deprecated
*.disabled
*.pid
*-backup.tsx