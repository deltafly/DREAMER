# ─────────────────────────────────────────────────────────────
# OneBrainer — environment configuration
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# `src/lib/env.ts` validates these at startup:
# missing required vars are a hard failure in production, a warning in dev.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Required. SQLite connection string (WAL mode is enabled by Prisma).
DATABASE_URL="file:./db/custom.db"

# ── Authentication (NextAuth.js v4) ─────────────────────────
# Required in production. JWT signing secret.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Required in production. The public URL of the app.
NEXTAUTH_URL="http://localhost:3000"

# ── LLM provider ────────────────────────────────────────────
# Which provider serves the Librarian, the Dreamer and the benchmark judge.
# Leave LLM_PROVIDER empty to auto-detect from whichever key is set below.
#   anthropic  official @anthropic-ai/sdk (Claude)
#   openai     any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=""

# Optional. Overrides the provider's default model.
# Defaults: anthropic=claude-opus-5, openai=gpt-4o-mini
LLM_MODEL=""

# Set one of these. Exporting a single key is the whole setup for a fresh clone.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Optional. Points the OpenAI-compatible adapter at another host. Anything that
# speaks the same shape works — the model name travels in LLM_MODEL.
#
#   OpenRouter (hundreds of models behind one key):
#     OPENAI_API_KEY=<openrouter key>
#     OPENAI_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=z-ai/glm-5.2          # or anthropic/claude-opus-5, etc.
#
#   Groq:    https://api.groq.com/openai/v1
#   Ollama:  http://localhost:11434/v1     (local, no API key required)
OPENAI_BASE_URL=""

# ── Semantic seeding (optional) ─────────────────────────────
# Off by default, and the system is complete without it.
#
# A brain query seeds itself by matching words, then spreads activation across
# the graph. That misses evidence phrased differently — ask about "the payment
# provider" and a fact that says "Barion" never lights up, and because seeding
# happens before spreading, the graph never gets the chance to reach anything
# behind it.
#
# Set EMBEDDING_MODEL and each fact also gets a vector, so a query seeds by
# meaning as well as by shared words. Both seed sets are merged; keyword matches
# keep their weight, because an exact term match is the one thing embeddings are
# worst at.
#
# Only the distilled fact layer is embedded — one sentence each, embedded once
# when written, not per query. The raw ledger is never sent anywhere. Leave it
# empty and queries seed by keyword exactly as before.
#
#   OpenAI:  EMBEDDING_MODEL=text-embedding-3-small
#   Ollama:  EMBEDDING_MODEL=nomic-embed-text
#            EMBEDDING_BASE_URL=http://localhost:11434/v1   (local, free, no key)
EMBEDDING_MODEL=""

# Optional. Defaults to OPENAI_BASE_URL, then to api.openai.com. Configured
# separately from the completion provider because Anthropic has no embeddings
# API — you can run the Librarian on Claude and the vectors on a local Ollama.
EMBEDDING_BASE_URL=""

# Optional. Defaults to OPENAI_API_KEY.
EMBEDDING_API_KEY=""

# ── Scheduler ───────────────────────────────────────────────
# Optional. Bearer token for POST /api/scheduler/tick, used by external
# cron runners (cron-job.org, AWS EventBridge, ...). Empty = endpoint disabled.
SCHEDULER_SECRET=""

# ── Logging ─────────────────────────────────────────────────
# Optional. One of: debug | info | warn | error
LOG_LEVEL="info"

# ── CORS ────────────────────────────────────────────────────
# Optional. Comma-separated allowed origins for the REST API.
# Dev default: localhost only. Prod default: same-origin.
API_ALLOWED_ORIGINS=""

# Optional. Separate allow-list for the MCP endpoint (/api/mcp), so AI clients
# can be permitted without widening the main API surface.
MCP_ALLOWED_ORIGINS=""

# ── Public ──────────────────────────────────────────────────
# Optional. Public URL advertised by the MCP discovery endpoint.
NEXT_PUBLIC_APP_URL=""
